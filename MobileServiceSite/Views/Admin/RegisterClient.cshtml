@model MobileServiceSite.Models.Client
@{
    ViewData["Title"] = "Регистрация клиента";
}
<div class="client-register">
    <h2>Данные клиента</h2>
    <p class="instruction">Введите данные клиента</p>

    <form method="post" action="/Admin/RegisterClient" class="client-form">
        <div class="form-group">
            <label for="first_name"><b>Имя</b></label>
            <input type="text" placeholder="Введите..."  name="first_name"/>
        </div>

        <div class="form-group">
            <label for="last_name"><b>Фамилия</b></label>
            <input type="text" placeholder="Введите..." name="last_name"/>
        </div>

        <div class="form-group">
            <label for="phone"><b>Номер телефона</b></label>
            <input type="text" placeholder="Введите..." name="phone"/>
        </div>

        <div class="form-group">
            <label for="email"><b>Email</b></label>
            <input type="email" placeholder="Введите..." name="email" />
        </div>

        <button type="submit" class="registerbtn">Зарегистрировать клиента</button>
        <a href="/Admin" class="back-btn">Назад в админ-панель</a>
    </form>
</div>
