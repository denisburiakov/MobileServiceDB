@model MobileServiceSite.Models.Client
@{
    ViewData["Title"] = "Client Registration";
}
<div class="client-register">
    <h2>Client Information</h2>
    <p class="instruction">Please enter client details</p>

    <form method="post" action="/Admin/RegisterClient" class="client-form">
        <div class="form-group">
            <label for="first_name"><b>First Name </b></label>
            <input type="text" placeholder="Please, enter..."  name="first_name"/>
        </div>

        <div class="form-group">
            <label for="last_name"><b>Last Name </b></label>
            <input type="text" placeholder="Please, enter..." name="last_name"/>
        </div>

        <div class="form-group">
            <label for="phone"><b>Phone Number </b></label>
            <input type="text" placeholder="Please, enter..." name="phone"/>
        </div>

        <div class="form-group">
            <label for="email"><b>Email</b></label>
            <input type="email" placeholder="Please, enter..." name="email" />
        </div>

        <button type="submit" class="registerbtn">Register Client</button>
        <a href="/Admin" class="back-btn">Back to Admin</a>
    </form>
</div>