@{
    ViewData["Title"] = "Информация о клиенте";
    var client = ViewBag.Client as MobileServiceSite.Models.Client;
    var devices = ViewBag.Devices as List<MobileServiceSite.Models.Device>;
    var services = ViewBag.Services as List<MobileServiceSite.Models.Service>;
    var details = ViewBag.Details as List<MobileServiceSite.Models.Detail>;
}

<div class="client-info-container">
    <a href="/Admin" class="back-btn">← Назад в админ-панель</a>

    <h1>👤 Информация о клиенте</h1>

    @if (client != null)
    {
        <!-- Информация о клиенте -->
        <div class="client-card">
            <h2>Данные клиента</h2>
            <div class="client-details">
                <div class="detail-row">
                    <span class="label">ID:</span>
                    <span class="value">@client.Id</span>
                </div>
                <div class="detail-row">
                    <span class="label">ФИО:</span>
                    <span class="value">@client.FirstName @client.LastName</span>
                </div>
                <div class="detail-row">
                    <span class="label">Телефон:</span>
                    <span class="value">@client.Phone</span>
                </div>
                <div class="detail-row">
                    <span class="label">Email:</span>
                    <span class="value">@(client.Email ?? "не указан")</span>
                </div>
            </div>
        </div>

        <!-- Устройства клиента -->
        <div class="devices-section">
            <h2>📱 Устройства (@devices?.Count)</h2>

            @if (devices != null && devices.Any())
            {
                @foreach (var device in devices)
                {
                    <div class="device-card">
                        <div class="order-head">
                            <h3>@device.Producer @device.Model</h3>
                            <a href="/Admin/EditDevice/@device.Id" class="mini-btn btn-price">✏️ Редактировать</a>
                        </div>
                        <div class="device-details">
                            <p><strong>Тип:</strong> @device.TypeOfDevice</p>
                            <p><strong>Серийный номер:</strong> @device.SerialNumber</p>
                            <p><strong>Проблема:</strong> @device.DefDescriotion</p>
                            <p><strong>ID устройства:</strong> @device.Id</p>
                        </div>

                        <!-- Сервисы для этого устройства -->
                        @{
                            var deviceServices = services?.Where(s => s.DeviceId == device.Id).ToList();
                        }
                        @if (deviceServices != null && deviceServices.Any())
                        {
                            <div class="services-list">
                                <h4>Услуги (@deviceServices.Count):</h4>
                                @foreach (var service in deviceServices)
                                {
                                    <div class="service-item">
                                        <p><strong>@service.TypeOfService</strong></p>
                                        <p>Стоимость: @service.CostOfService BYN</p>
                                        <p>Время: @(service.TimeOfDoing ?? "не указано")</p>
                                        @if (service.Category != null)
                                        {
                                            <p>Категория: @service.Category.Categories</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="no-data">Услуг для этого устройства нет</p>
                        }

                        <!-- Детали для этого устройства -->
                        @{
                            var deviceDetails = details?.Where(d => d.DeviceId == device.Id).ToList();
                        }
                        @if (deviceDetails != null && deviceDetails.Any())
                        {
                            <div class="details-list">
                                <h4>Детали (@deviceDetails.Count):</h4>
                                @foreach (var detail in deviceDetails)
                                {
                                    <div class="detail-item">
                                        <p><strong>@detail.TypeOfDetail</strong></p>
                                        <p>Производитель: @detail.ProducerDet</p>
                                        <p>Стоимость: @detail.CostOfDetail BYN</p>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="no-data">Деталей для этого устройства нет</p>
                        }
                    </div>
                }
            }
            else
            {
                <p class="no-data">У этого клиента нет устройств</p>
            }
        </div>

        <!-- Общая статистика -->
        <div class="stats-summary">
            <h2>Итого</h2>
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">@devices?.Count</div>
                    <div class="stat-label">Всего устройств</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">@services?.Count</div>
                    <div class="stat-label">Всего услуг</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">@details?.Count</div>
                    <div class="stat-label">Всего деталей</div>
                </div>
                <div class="stat-card">
                    @{
                        var totalSpent = (services?.Sum(s => s.CostOfService) ?? 0) +
                        (details?.Sum(d => d.CostOfDetail) ?? 0);
                    }
                    <div class="stat-number">@totalSpent BYN</div>
                    <div class="stat-label">Общая сумма</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="error-message">
            <h2>Клиент не найден</h2>
            <p>Клиент с телефоном не найден: @ViewBag.SearchPhone</p>
        </div>
    }
</div>
