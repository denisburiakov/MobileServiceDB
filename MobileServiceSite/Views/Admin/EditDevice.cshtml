@model MobileServiceSite.Models.Device
@{
    ViewData["Title"] = "Редактирование устройства";
}

<div class="client-info-container">
    <a href="javascript:history.back()" class="back-btn">← Назад</a>

    <h1>✏️ Редактирование устройства</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error">@TempData["ErrorMessage"]</div>
    }

    <div class="order-card">
        <p><strong>Владелец:</strong> @Model.Client.FirstName @Model.Client.LastName (@Model.Client.Phone)</p>
        <p><strong>ID устройства:</strong> @Model.Id</p>
    </div>

    <form method="post" action="/Admin/EditDevice/@Model.Id" class="edit-form">
        <label for="type_of_device">Тип устройства</label>
        <input type="text" id="type_of_device" name="type_of_device" maxlength="50" required
               value="@Model.TypeOfDevice" />

        <label for="producer">Производитель</label>
        <input type="text" id="producer" name="producer" maxlength="50" required
               value="@Model.Producer" />

        <label for="model">Модель</label>
        <input type="text" id="model" name="model" maxlength="50" required
               value="@Model.Model" />

        <label for="serial_number">Серийный номер</label>
        <input type="text" id="serial_number" name="serial_number" maxlength="50"
               value="@Model.SerialNumber" />

        <label for="def_descriotion">Описание неисправности</label>
        <textarea id="def_descriotion" name="def_descriotion" rows="3" maxlength="500">@Model.DefDescriotion</textarea>

        <div class="edit-actions">
            <button type="submit" class="order-btn">💾 Сохранить</button>
            <a href="/Admin/SearchClient?phone=@Uri.EscapeDataString(Model.Client.Phone)" class="back-btn">Отмена</a>
        </div>
    </form>
</div>
