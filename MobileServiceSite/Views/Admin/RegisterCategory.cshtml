@model MobileServiceSite.Models.Category
@{
    ViewData["Title"] = "Регистрация категории";
}
<div class="client-register">
    <h2>Категория услуги</h2>
    <p class="instruction">Введите название категории</p>

    <form method="post" action="/Admin/RegisterCategory" class="client-form">
        <div class="form-group">
            <label for="category"><b>Название категории</b></label>
            <input type="text" placeholder="Введите..." name="category" required />
        </div>

        <button type="submit" class="registerbtn">Зарегистрировать категорию</button>
        <a href="/Admin" class="back-btn">Назад в админ-панель</a>
    </form>
</div>
