@model MobileServiceSite.Models.Detail
@{
    ViewData["Title"] = "Регистрация детали";
}
<div class="client-register">
    <h2>Данные детали</h2>
    <p class="instruction">Введите данные детали (запчасти)</p>

    <form method="post" action="/Admin/RegisterDetail" class="client-form">
        <div class="form-group">
            <label for="DeviceId"><b>ID устройства</b></label>
            <input type="number" placeholder="Введите..." name="device_id" required />
            <small>Найти ID устройства можно в таблице устройств</small>
        </div>

        <div class="form-group">
            <label for="TypeOfDetail"><b>Тип детали</b></label>
            <input type="text" placeholder="Введите..." name="type_of_detail" required />
        </div>

        <div class="form-group">
            <label for="ProducerDet"><b>Производитель</b></label>
            <input type="text" placeholder="Введите..." name="producer_det" required />
        </div>

        <div class="form-group">
            <label for="CostOfDetail"><b>Стоимость</b></label>
            <input type="number" placeholder="Введите..." name="cost_of_detail" min="0" required />
        </div>

        <button type="submit" class="registerbtn">Зарегистрировать деталь</button>
        <a href="/Admin" class="back-btn">Назад в админ-панель</a>
    </form>
</div>
