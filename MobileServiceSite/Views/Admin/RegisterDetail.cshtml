@model MobileServiceSite.Models.Detail
@{
    ViewData["Title"] = "Detail Registration";
}
<div class="client-register">
    <h2>Part/Detail Information</h2>
    <p class="instruction">Please enter part details</p>

    <form method="post" action="/Admin/RegisterDetail" class="client-form">
        <div class="form-group">
            <label for="DeviceId"><b>Device ID </b></label>
            <input type="number" placeholder="Please, enter..." name="device_id" required />
            <small>Find device ID in the devices table</small>
        </div>

        <div class="form-group">
            <label for="TypeOfDetail"><b>Part Type</b></label>
            <input type="text" placeholder="Please, enter..." name="type_of_detail" required />
        </div>

        <div class="form-group">
            <label for="ProducerDet"><b>Manufacturer</b></label>
            <input type="text" placeholder="Please, enter..." name="producer_det" required />
        </div>

        <div class="form-group">
            <label for="CostOfDetail"><b>Cost</b></label>
            <input type="number" placeholder="Please, enter..." name="cost_of_detail" min="0" required />
        </div>

        <button type="submit" class="registerbtn">Register Part</button>
        <a href="/Admin" class="back-btn">Back to Admin</a>
    </form>
</div>