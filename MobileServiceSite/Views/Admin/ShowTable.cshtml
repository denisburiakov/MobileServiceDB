<a href="/Admin" class="back-btn">← Назад в админ-панель</a>

<div class="table-container">
    @if (Model is System.Collections.IEnumerable)
    {
        <table class="data-table">
            <thead>
                <tr>
                    @{
                        var props = Model.GetType().GetGenericArguments()[0].GetProperties();
                        var excludeNames = new string[] { "Client", "Details", "Services", "Device", "Category" };

                        // Русские названия колонок вместо технических имён свойств
                        var ruHeaders = new Dictionary<string, string>
                        {
                            ["Id"] = "ID",
                            ["FirstName"] = "Имя",
                            ["LastName"] = "Фамилия",
                            ["Phone"] = "Телефон",
                            ["Email"] = "Email",
                            ["ClientId"] = "ID клиента",
                            ["DeviceId"] = "ID устройства",
                            ["CategoryId"] = "ID категории",
                            ["TypeOfDevice"] = "Тип устройства",
                            ["Producer"] = "Производитель",
                            ["Model"] = "Модель",
                            ["SerialNumber"] = "Серийный номер",
                            ["DefDescriotion"] = "Описание проблемы",
                            ["TypeOfDetail"] = "Тип детали",
                            ["CostOfDetail"] = "Стоимость детали, BYN",
                            ["ProducerDet"] = "Производитель детали",
                            ["TypeOfService"] = "Услуга",
                            ["TimeOfDoing"] = "Время выполнения",
                            ["CostOfService"] = "Стоимость услуги, BYN",
                            ["Categories"] = "Категория",
                            ["Description"] = "Описание заявки",
                            ["Price"] = "Цена, BYN",
                            ["Status"] = "Статус",
                            ["CreatedAt"] = "Создан",
                            ["PriceSetAt"] = "Цена установлена",
                            ["PaidAt"] = "Оплачен"
                        };

                        foreach (var prop in props)
                        {
                            bool show = true;
                            foreach (var exclude in excludeNames)
                            {
                                if (prop.Name.Contains(exclude))
                                {
                                    show = false;
                                    break;
                                }
                            }
                            if (show && !prop.GetGetMethod().IsVirtual)
                            {
                                <th>@(ruHeaders.ContainsKey(prop.Name) ? ruHeaders[prop.Name] : prop.Name)</th>
                            }
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @{
                            var itemProps = item.GetType().GetProperties();

                            foreach (var prop in itemProps)
                            {
                                bool show = true;

                                foreach (var exclude in excludeNames)
                                {
                                    if (prop.Name.Contains(exclude))
                                    {
                                        show = false;
                                        break;
                                    }
                                }

                                if (show && !prop.GetGetMethod().IsVirtual)
                                {
                                    var value = prop.GetValue(item);

                                    if (prop.PropertyType == typeof(string) && prop.Name == "Status" && value != null)
                                    {
                                        <td>@MobileServiceSite.Models.OrderStatus.Display(value.ToString())</td>
                                    }
                                    else if (prop.PropertyType == typeof(DateTime) && value != null)
                                    {
                                        <td>@(((DateTime)value).ToString("dd.MM.yyyy HH:mm"))</td>
                                    }
                                    else if (prop.PropertyType == typeof(DateTime?) && value != null)
                                    {
                                        <td>@(((DateTime)value).ToString("dd.MM.yyyy HH:mm"))</td>
                                    }
                                    else
                                    {
                                        <td>@value</td>
                                    }
                                }
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
