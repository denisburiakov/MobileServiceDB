@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<h1 class="text-danger">Ошибка.</h1>
<h2 class="text-danger">При обработке запроса произошла ошибка.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID запроса:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Режим разработки</h3>
<p>
    При переключении окружения на <strong>Development</strong> будет показана более подробная информация об ошибке.
</p>
<p>
    <strong>Окружение Development не должно быть включено в опубликованных приложениях.</strong>
    Оно может привести к утечке конфиденциальных данных из исключений для конечных пользователей.
    Для локальной отладки установите переменную окружения <strong>ASPNETCORE_ENVIRONMENT</strong> в значение <strong>Development</strong>
    и перезапустите приложение.
</p>
