
@{
    ViewData["Title"] = "Готово";
}

<div class="success-page">
    <h1>Готово!</h1>
    @if (TempData["SuccessMessage"] != null)
    {
        <p style="color: #28a745; font-size: 18px;">@TempData["SuccessMessage"]</p>
    }
    else
    {
        <p>Ваши данные успешно сохранены.</p>
    }

    <div class="back-home">
        <a href="/" class="home-link">← На главную страницу</a>
    </div>
</div>
