@{
    ViewData["Title"] = "Клиент";
}
<div class="client-register">
    <h2>Регистрация клиента</h2>
    <p class="instruction">Введите свои контактные данные. Если вы уже регистрировались — просто укажите тот же телефон, и мы войдём в ваш кабинет.</p>

    @if (TempData["ErrorMessage"] != null)
    {
        <p class="error-message-text" style="color: red;">@TempData["ErrorMessage"]</p>
    }

    <form method="post" class="client-form">
        <div class="form-group">
            <label for="first_name"><b>Имя</b></label>
            <input type="text" placeholder="Введите..." name="first_name" required />
        </div>

        <div class="form-group">
            <label for="last_name"><b>Фамилия</b></label>
            <input type="text" placeholder="Введите..." name="last_name" required />
        </div>

        <div class="form-group">
            <label for="phone"><b>Номер телефона</b></label>
            <input type="text" placeholder="Введите..." name="phone" required />
        </div>

        <div class="form-group">
            <label for="email"><b>Email</b></label>
            <input type="text" placeholder="Введите..." name="email" />
        </div>

        <button type="submit" class="registerbtn">Зарегистрироваться</button>
    </form>

    <hr />

    <h3>Уже есть аккаунт?</h3>
    <form method="get" action="/Client/Login" class="client-form">
        <div class="form-group">
            <label for="phone"><b>Номер телефона</b></label>
            <input type="text" placeholder="Введите ваш телефон..." name="phone" required />
        </div>
        <button type="submit" class="registerbtn">Войти в личный кабинет</button>
    </form>
</div>
