@{
    ViewData["Title"] = "Личный кабинет";
    var client = ViewBag.Client as MobileServiceSite.Models.Client;
    var devices = ViewBag.Devices as List<MobileServiceSite.Models.Device>;
    var services = ViewBag.Services as List<MobileServiceSite.Models.Service>;
    var details = ViewBag.Details as List<MobileServiceSite.Models.Detail>;
    var orders = ViewBag.Orders as List<MobileServiceSite.Models.Order>;
}

<div class="client-info-container">
    <a href="/" class="back-btn">← На главную</a>

    <h1>👤 Личный кабинет</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (client != null)
    {
        <div class="client-card">
            <h2>Ваши данные</h2>
            <div class="client-details">
                <div class="detail-row">
                    <span class="label">ID:</span>
                    <span class="value">@client.Id</span>
                </div>
                <div class="detail-row">
                    <span class="label">ФИО:</span>
                    <span class="value">@client.FirstName @client.LastName</span>
                </div>
                <div class="detail-row">
                    <span class="label">Телефон:</span>
                    <span class="value">@client.Phone</span>
                </div>
                <div class="detail-row">
                    <span class="label">Email:</span>
                    <span class="value">@(client.Email ?? "не указан")</span>
                </div>
            </div>
        </div>

        <div class="devices-section">
            <h2>📱 Ваши устройства (@devices?.Count)</h2>

            @if (devices != null && devices.Any())
            {
                @foreach (var device in devices)
                {
                    <div class="device-card">
                        <h3>@device.Producer @device.Model</h3>
                        <div class="device-details">
                            <p><strong>Тип:</strong> @device.TypeOfDevice</p>
                            <p><strong>Серийный номер:</strong> @device.SerialNumber</p>
                            <p><strong>Проблема:</strong> @device.DefDescriotion</p>
                        </div>

                        @{
                            var deviceServices = services?.Where(s => s.DeviceId == device.Id).ToList();
                        }
                        @if (deviceServices != null && deviceServices.Any())
                        {
                            <div class="services-list">
                                <h4>Услуги (@deviceServices.Count):</h4>
                                @foreach (var service in deviceServices)
                                {
                                    <div class="service-item">
                                        <p><strong>@service.TypeOfService</strong></p>
                                        <p>Стоимость: @service.CostOfService BYN</p>
                                        <p>Время: @(service.TimeOfDoing ?? "не указано")</p>
                                        @if (service.Category != null)
                                        {
                                            <p>Категория: @service.Category.Categories</p>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @{
                            var deviceDetails = details?.Where(d => d.DeviceId == device.Id).ToList();
                        }
                        @if (deviceDetails != null && deviceDetails.Any())
                        {
                            <div class="details-list">
                                <h4>Детали (@deviceDetails.Count):</h4>
                                @foreach (var detail in deviceDetails)
                                {
                                    <div class="detail-item">
                                        <p><strong>@detail.TypeOfDetail</strong></p>
                                        <p>Производитель: @detail.ProducerDet</p>
                                        <p>Стоимость: @detail.CostOfDetail BYN</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <p class="no-data">Устройств пока нет — добавьте первое прямо при создании заявки ниже</p>
            }
        </div>

        <!-- ===================== ЗАЯВКИ ===================== -->
        <div class="orders-section">
            <h2>📋 Мои заявки на ремонт (@orders?.Count)</h2>

            <!-- Новая заявка: устройство и неисправность заполняет сам клиент -->
            <div class="order-create">
                <h3>Создать заявку на ремонт</h3>
                <form method="post" action="/Client/CreateRequest" class="order-form" id="requestForm">
                    <input type="hidden" name="client_id" value="@client.Id" />

                    <div class="form-group">
                        <label for="order_device">Устройство</label>
                        <select name="device_id" id="order_device">
                            <option value="0">➕ Новое устройство — ввести данные</option>
                            @if (devices != null)
                            {
                                @foreach (var d in devices)
                                {
                                    <option value="@d.Id">@d.Producer @d.Model (@d.SerialNumber)</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Данные нового устройства: заполняет клиент -->
                    <div id="newDeviceFields" style="display: none;">
                        <div class="form-group">
                            <label for="device_type">Тип устройства</label>
                            <input type="text" id="device_type" name="device_type" maxlength="50"
                                   placeholder="Например: смартфон, ноутбук, планшет" />
                        </div>
                        <div class="form-group">
                            <label for="producer">Производитель</label>
                            <input type="text" id="producer" name="producer" maxlength="50"
                                   placeholder="Например: Apple, Samsung, Xiaomi" />
                        </div>
                        <div class="form-group">
                            <label for="model">Модель</label>
                            <input type="text" id="model" name="model" maxlength="50"
                                   placeholder="Например: iPhone 13" />
                        </div>
                        <div class="form-group">
                            <label for="serial_number">Серийный номер <span class="optional">(необязательно)</span></label>
                            <input type="text" id="serial_number" name="serial_number" maxlength="50"
                                   placeholder="Если он у вас есть" />
                        </div>
                        <div class="form-group">
                            <label for="device_problem">Что случилось с устройством</label>
                            <textarea id="device_problem" name="device_problem" rows="2" maxlength="50"
                                      placeholder="Кратко опишите неисправность"></textarea>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="order_description">Что нужно сделать</label>
                        <textarea name="description" id="order_description" rows="3" maxlength="500" required
                                  placeholder="Опишите проблему или желаемую работу"></textarea>
                    </div>

                    <button type="submit" class="order-btn">➕ Создать заявку</button>
                </form>
                <p class="order-hint">
                    Заявку составляете вы сами: выбираете устройство (или добавляете новое) и описываете неисправность.
                    После этого администратор посмотрит заявку, установит цену — и вы сможете её оплатить.
                </p>
            </div>

            <!-- Список заявок -->
            @if (orders != null && orders.Any())
            {
                @foreach (var order in orders)
                {
                    <div class="order-card">
                        <div class="order-head">
                            <h4>Заявка №@order.Id</h4>
                            <span class="order-status">@OrderStatus.Display(order.Status)</span>
                        </div>

                        <p><strong>Устройство:</strong> @order.Device.Producer @order.Device.Model</p>
                        <p><strong>Описание:</strong> @order.Description</p>
                        <p>
                            <strong>Цена:</strong>
                            @(order.Price.HasValue ? order.Price + " BYN" : "не установлена")
                        </p>
                        <p class="order-date">Создана: @order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>

                        @if (order.Status == MobileServiceSite.Models.OrderStatus.Created)
                        {
                            <span class="order-note note-wait">⏳ Ожидает установки цены администратором</span>
                        }
                        else if (order.Status == MobileServiceSite.Models.OrderStatus.AwaitingPayment)
                        {
                            <a href="/Client/Pay/@order.Id" class="pay-btn">💳 Оплатить @order.Price BYN</a>
                        }
                        else if (order.Status == MobileServiceSite.Models.OrderStatus.Paid)
                        {
                            <span class="order-note note-paid">✅ Оплачено @order.PaidAt?.ToString("dd.MM.yyyy HH:mm") — администратор получил уведомление</span>
                        }
                        else if (order.Status == MobileServiceSite.Models.OrderStatus.InProgress)
                        {
                            <span class="order-note note-work">🛠 Ваш заказ в работе</span>
                        }
                        else if (order.Status == MobileServiceSite.Models.OrderStatus.Completed)
                        {
                            <span class="order-note note-done">✅ Заказ выполнен</span>
                        }
                    </div>
                }
            }
            else
            {
                <p class="no-data">Заявок пока нет</p>
            }
        </div>
    }
    else
    {
        <p>Клиент не найден.</p>
    }
</div>

@if (client != null)
{
    <script>
        (function () {
            var select = document.getElementById('order_device');
            var fields = document.getElementById('newDeviceFields');
            if (!select || !fields) return;

            function toggle() {
                var isNew = select.value === '0';
                fields.style.display = isNew ? 'block' : 'none';

                // Для нового устройства обязательны тип, производитель и модель
                var ids = ['device_type', 'producer', 'model'];
                ids.forEach(function (id) {
                    var el = document.getElementById(id);
                    if (!el) return;
                    if (isNew) {
                        el.setAttribute('required', 'required');
                    } else {
                        el.removeAttribute('required');
                    }
                });
            }

            select.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
