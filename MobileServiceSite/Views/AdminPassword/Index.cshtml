
@{
    ViewData["Title"] = "Admin Password";
}
<div class="admin-login-container">
    <div class="login-box">
        <h2>Admin Access Required</h2>
        <p class="instruction">Please enter the admin password to continue</p>
        
        <form method="post" action="/AdminPassword/Authenticate" class="password-form">
            <div class="input-group">
                <label for="password">Admin Password:</label>
                <input type="password" 
                       id="password" 
                       name="password" 
                       placeholder="Enter admin password" 
                       required 
                       autofocus>
            </div>
            
            <div class="form-actions">
                <button type="submit" class="btn-submit">Login</button>
                <a href="/" class="btn-cancel">Back to Home</a>
            </div>
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-message">
                    Invalid password. Please try again.
                </div>
            }

        </form>
    </div>
</div>

