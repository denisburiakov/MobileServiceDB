
@{
    ViewData["Title"] = "Вход администратора";
}
<div class="admin-login-container">
    <div class="login-box">
        <h2>Требуется вход администратора</h2>
        <p class="instruction">Введите пароль администратора, чтобы продолжить</p>
        
        <form method="post" action="/AdminPassword/Authenticate" class="password-form">
            <div class="input-group">
                <label for="password">Пароль администратора:</label>
                <input type="password" 
                       id="password" 
                       name="password" 
                       placeholder="Введите пароль администратора" 
                       required 
                       autofocus>
            </div>
            
            <div class="form-actions">
                <button type="submit" class="btn-submit">Войти</button>
                <a href="/" class="btn-cancel">На главную</a>
            </div>
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-message">
                    Неверный пароль. Попробуйте ещё раз.
                </div>
            }

        </form>
    </div>
</div>
